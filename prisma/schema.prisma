generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleCategory {
  ENGINEERING
  PRODUCT
  DESIGN
  DATA
  MANAGEMENT
}

model Company {
  id String @id @default(uuid())

  name String
  normalized_name String @unique
  slug String @unique

  industry String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  compensations Compensation[]

  @@map("companies")
}

model Role {
  id String @id @default(uuid())

  name String @unique

  category RoleCategory?

  created_at DateTime @default(now())

  compensations Compensation[]

  @@map("roles")
}

model Level {
  id String @id @default(uuid())

  name String

  code String @unique

  order Int @unique

  description String?

  created_at DateTime @default(now())

  compensations Compensation[]

  @@map("levels")
}

model Location {
  id String @id @default(uuid())

  city String

  state String?

  country String

  normalized String @unique

  created_at DateTime @default(now())

  compensations Compensation[]

  @@map("locations")
}

model Compensation {
  id String @id @default(uuid())

  company_id String
  role_id String
  level_id String
  location_id String

  base_salary Decimal

  bonus Decimal @default(0)

  stock_value Decimal @default(0)

  total_compensation Decimal

  years_of_experience Int?

  currency String @default("USD")

  verified Boolean @default(false)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  role Role @relation(fields: [role_id], references: [id])

  level Level @relation(fields: [level_id], references: [id])

  location Location @relation(fields: [location_id], references: [id])

  @@index([company_id])

  @@index([role_id])

  @@index([level_id])

  @@index([location_id])

  @@index([company_id, role_id, level_id, location_id])

  @@map("compensations")
}